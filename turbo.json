{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_*",
    "VITE_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "OPENAI_API_KEY",
        "DATABASE_URL",
        "DB_*",
        "AVA_MYSQL_*",
        "AVA_PROJECT_SELECTION_TELEMETRY",
        "AVA_ALLOWED_ORIGINS",
        "AVA_SESSION_COOKIE_*",
        "RESEND_API_KEY"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "build/**",
        "coverage/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
